# 本机配置放在 backend/.env；此模板不包含真实密钥。
# .env 不提交版本库，已有的终端环境变量优先于本文件。
# 修改配置后请重启后端，不会在请求期间自动重读。

# rule：离线规则演示；qwen：启用通义千问。
PARK_AI_MODE=rule

# 在本机 .env 中填写阿里云百炼 API Key，不要发到聊天中。
DASHSCOPE_API_KEY=

# 示例为北京入口；入口地域必须与 API Key 的地域一致。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_SECONDS=15

# 飞书企业自建应用；只填写到本机 .env，不发送到聊天。
# 单聊长连接不需要公网回调URL。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 可选：逗号分隔的本人open_id；未配置时使用本机配对码授权单聊测试。
FEISHU_ALLOWED_OPEN_IDS=
# 以下仅用于旧的Webhook接收方式，长连接不依赖它们。
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
