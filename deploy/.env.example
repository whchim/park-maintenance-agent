# 复制为 deploy/.env.demo；启动时显式传 --env-file deploy/.env.demo。
# 使用 caddy hash-password 交互生成 bcrypt 哈希，不在命令参数里输入明文密码。
# 哈希必须用单引号括住，避免 $ 被环境文件插值；不提供默认访问密码。
DEMO_USER=demo
DEMO_PASSWORD_HASH=''
DEMO_HTTP_PORT=8080
# 无域名临时IP演示可改为0.0.0.0；有域名部署建议保留127.0.0.1并使用公网覆盖配置。
DEMO_BIND_HOST=127.0.0.1
# 只有公网覆盖文件使用本项；填写自己拥有并已解析到服务器的域名。
DEMO_DOMAIN=

# 默认离线；qwen 才会发送真实模型请求。
PARK_AI_MODE=rule
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# UTC每天最多100次供应商请求，含失败请求；不是100张工单或100元。
PARK_MODEL_DAILY_LIMIT=100
PARK_MODEL_PER_MINUTE_LIMIT=10
