# 模型密钥只保存在本机，不提交环境配置文件。
.env
.env.*
!.env.example

# Python / 前端依赖和构建产物在安装时重新生成。
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-*/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
dist/
*.tsbuildinfo

# 数据库、日志和本机工具缓存不作为源码发布。
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
.agents/
.codex/

# 此目录包含个人简历、提交归档及本机构建资料。
deliverables/

# 现场图片属于运行数据，不提交到代码库。
backend/var/uploads/
backend/.uv-attachment-cache/
# 演示升级的本机快照，不作为项目资料发布。
backend/.local/

# 部署访问凭据与本机验证工具不随源码发布。
deploy/secrets/
backups/
